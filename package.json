{
  "name": "margen-joias",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-detail-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run assets && npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check:build": "node scripts/check-build.mjs && node scripts/check-products.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
